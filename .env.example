# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-your-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI Model API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# External Search & Contact Discovery APIs (Optional)
TAVILY_API_KEY=your_tavily_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Browser Automation (Set to true for cloud deployments like Render)
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chromium
PLAYWRIGHT_TIMEOUT_MS=30000
